{
  "frond": "0.3.0",
  "atoms": {
    "A1":  { "class": "c-title",       "variants": ["cover", "sm", "xl"] },
    "A2":  { "classes": ["c-sub", "c-body", "c-caption"], "variants": { "c-body": ["muted"] } },
    "A3":  { "class": "c-badge",       "variants": ["ghost", "num", "outline"] },
    "A4":  { "class": "c-stat",        "variants": ["boxed", "ink", "sm"] },
    "A5":  { "class": "c-check",       "variants": ["dash", "dot", "no", "yes"] },
    "A6":  { "class": "c-num",         "variants": ["circle", "ghost", "ring"] },
    "A7":  { "class": "c-cta",         "variants": ["outline", "plain"] },
    "A8":  { "class": "c-quote",       "variants": ["bar", "plain"] },
    "A9":  { "class": "c-icon-bullet", "variants": [] },
    "A10": { "class": "c-avatar",      "variants": ["lg", "ring"] },
    "A11": { "class": "c-hl",          "variants": ["box", "italic", "underline"] },
    "A12": { "class": "c-bignum",      "variants": ["ghost"] },
    "A13": { "class": "c-step",        "variants": ["h"] },
    "A14": { "class": "c-decor",       "variants": ["dots", "lines", "glow", "mesh", "top", "bottom", "right"] },
    "A15": { "class": "c-img",         "variants": ["11", "43", "169", "bleed", "framed", "rounded"] },
    "A16": { "classes": ["c-device", "c-code"], "variants": { "c-device": ["code", "flush", "phone"] } },
    "A17": { "class": "c-repo",        "variants": [] },
    "A18": { "class": "c-decide",      "variants": [] },
    "A19": { "class": "c-table",       "variants": [] }
  },
  "molecules": {
    "M1":  { "class": "slide",        "variants": ["accent", "surface", "start", "between", "end"] },
    "M2":  { "class": "m-cover",      "variants": ["bottom"] },
    "M3":  { "class": "m-list",       "variants": ["2col", "auto", "tight"] },
    "M4":  { "class": "m-checklist",  "variants": [] },
    "M5":  { "class": "m-stats",      "variants": ["1", "2", "3", "4", "rows"] },
    "M6":  { "class": "m-quote",      "variants": [] },
    "M7":  { "class": "m-cta",        "variants": [] },
    "M8":  { "class": "m-statement",  "variants": ["center"] },
    "M9":  { "class": "m-process",    "variants": ["h"] },
    "M10": { "class": "m-compare",    "variants": ["boxed", "vs"] },
    "M11": { "class": "m-pillars",    "variants": ["2", "3", "4", "bento"] },
    "M12": { "class": "m-split",      "variants": ["flip", "overlay", "wide-img", "wide-text"] },
    "M13": { "class": "m-number",     "variants": ["ghost"] },
    "M14": { "class": "m-profile",    "variants": [] },
    "M15": { "class": "m-decide",     "variants": [] },
    "M16": { "class": "m-mockup",     "variants": [] }
  },
  "grounds":  ["light", "dark", "accent", "surface"],
  "textures": ["none", "dots", "lines", "glow", "mesh"],
  "sizes":    ["portrait-1350", "square", "portrait-1200", "widescreen"],
  "icons": {
    "required": {
      "i-check": ".c-check--yes .c-check__i (A5)",
      "i-cross": ".c-check--no .c-check__i (A5)",
      "i-arrow": ".c-swipe__arrow (frame.css)"
    },
    "open": ["c-icon-bullet__i", "m-pillar__i"]
  }
}
